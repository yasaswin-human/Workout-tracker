{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "msedge",
            "request": "launch",
            "name": "Edge (Port 8080)",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}",
            "runtimeArgs": ["--auto-open-devtools-for-tabs"]
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Edge (Live Server 5500)",
            "url": "http://localhost:5500",
            "webRoot": "${workspaceFolder}",
            "runtimeArgs": ["--auto-open-devtools-for-tabs"]
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Edge (Python HTTP 8000)",
            "url": "http://localhost:8000",
            "webRoot": "${workspaceFolder}",
            "runtimeArgs": ["--auto-open-devtools-for-tabs"]
        },
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Chrome (Port 8080)",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}",
            "runtimeArgs": ["--auto-open-devtools-for-tabs"]
        }
    ]
}